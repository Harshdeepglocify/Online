		$report_hash   = hash('sha256', $request_data);
		
		$check = "SELECT id FROM export_queue WHERE user_id = '$user_id' AND status = 'pending' AND csv_type = '$report_type' AND is_single = '0' LIMIT 1";

		$result = mysqli_query($con, $check);

		$sql = "SELECT request_count 
        FROM report_requests 
        WHERE teacher_id = '$user_id' 
        AND report_hash = '$report_hash' AND 
		csv_type = '$report_type'  AND is_single = '0'
		";

		$res = mysqli_query($con, $sql);
		
		$request_count = 0; 
		
		if ($res && mysqli_num_rows($res) > 0) {
			$row = mysqli_fetch_assoc($res);
			$request_count = (int)$row['request_count'];
		}
		if( $request_count != 5  || $request_count != '5' ){

		if (mysqli_num_rows($result) > 0) {
			// Already has a pending request
			echo json_encode([
				"Success" => "409",
				"msg" => "You already submitted a request, please wait."
			]);
		} else {
			// Insert new request
			
			if($request_count == 0 || $request_count == "0" || $request_count == '' || $request_count == null  ){
			$request = "INSERT INTO report_requests (teacher_id, report_hash, csv_type , request_count , is_single) 
                        VALUES ('$user_id', '$report_hash' ,'$report_type' , '1' ,'0')";
			}else{
			$request = "UPDATE report_requests SET request_count = request_count + 1
                   WHERE teacher_id = '$user_id' 
                   AND report_hash = '$report_hash' 
                   AND csv_type = '$report_type' AND is_single = '0'";
		
			}
			//print_r($request);die();
			$request_result = mysqli_query($con, $request);
			
			$sql_downloads 	= "INSERT INTO report_downloads (user_id, user_email, file_status , report_hash, report_type,is_single, created_at) VALUES ('$user_id', '$user_email', 'Processing' , '$reportreq' ,
			'$report_type' , '0' , NOW() )";
			
			$request_downloads = mysqli_query($con, $sql_downloads);	
			
			if($request_downloads){
			$inserted_id 	= mysqli_insert_id($con); 
			}  
			$query = "INSERT INTO export_queue (user_id, user_email, status , csv_type , student_data , stuadm ,dwn_lnk_id, is_single) VALUES ('$user_id', '$user_email', '$status' ,'$report_type' , '$student_ids_json' , '$stuadm' ,
					  '$inserted_id' , '0' )";
					  //print_r($query);die();
			$query_result = mysqli_query($con, $query);

			if ($query_result) {
				echo json_encode([
					"Success" => "200",
					"msg" => "We’ll email you the Typio History CSV when it’s ready."
				]);
			} else {
				echo json_encode([
					"Success" => "500",
					"msg" => "Database error: " . mysqli_error($con)
				]);
			}
		}
		}else{
			
			echo json_encode([
				"Success" => "409",
				"msg" => "The same CSV was requested recently. Kindly wait before making another request."
			]);
		}
	
